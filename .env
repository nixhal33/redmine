# Copy to .env and edit. Compose reads this via env_file / ${VAR}.
# See config/database.yml.example and config/configuration.yml.example.

# --- App ---
RAILS_ENV=production
# to generate random secret key use this command: "openssl rand -hex 40"
REDMINE_SECRET_KEY_BASE=8be7fc1e1d7c725f63d1c9a4674036c19cbfa0fe0cd81c0f5ed876671173a8d56007920ad50ffccd
# Optional: encrypts SCM/LDAP/TOTP in DB (configuration.yml database_cipher_key)
# REDMINE_CIPHER_KEY=change-me-too

# --- Pick ONE database URL ---

# Here: mysql=adapter,dbuser=techhaus,dbpass=techhaus'%40=@'123,@db=db&pass connector,3306=dbport,dbname=techhausdb
DATABASE_URL=mysql2://techhaus:techhaus%40123@db:3306/techhausdb?encoding=utf8mb4
# PostgreSQL variant:
# DATABASE_URL=postgresql://redmine:redmine@db:5432/redmine
# SQLite3 variant (single-node, remove db service):
# DATABASE_URL=sqlite3:db/redmine.sqlite3

# --- Fallback if DATABASE_URL is unset (entrypoint builds database.yml from these) ---
REDMINE_DB_ADAPTER=mysql2
REDMINE_DB_HOST=db
REDMINE_DB_PORT=3306
REDMINE_DB_NAME=techhausdb
REDMINE_DB_USER=techhaus
REDMINE_DB_PASS=techhaus@123

# --- MySQL container ---
MYSQL_DATABASE=techhausdb
MYSQL_USER=techhaus
MYSQL_PASSWORD=techhaus@123
MYSQL_ROOT_PASSWORD=@TheST@rt2

# --- Optional mail (else mount config/configuration.yml) ---
# REDMINE_SMTP_ADDRESS=mail.example.com
# REDMINE_SMTP_PORT=25
